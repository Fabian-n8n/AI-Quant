# Copy to .env and fill in. .env is gitignored and must stay that way.
# Never paste real keys into a chat window.
#
# Get these from the Alpaca dashboard: log in, scroll to the API keys panel,
# generate a key, and copy both halves. The secret is shown only once.

ALPACA_API_KEY=your_key_here
ALPACA_SECRET_KEY=your_secret_here
ALPACA_PAPER=true
ALPACA_BASE_URL=https://paper-api.alpaca.markets
