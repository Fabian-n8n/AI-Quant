# Secrets. Never commit.
.env
config/credentials.yaml
*.pem
*.key

# Runtime state.
#
# state_snapshot.json is committed, unlike the halt lock. The GitHub runner is
# a fresh machine every run, so without it the peak-equity baseline resets to
# whatever the account is worth today and the drawdown breaker can never fire.
# It holds equity figures and regime history, no credentials and no order ids,
# and the same numbers are already on the public dashboard.
#
# The halt lock stays ignored on purpose. Committing it would propagate a halt
# to every future run, and clearing it is meant to be a deliberate local act.
trading_halted.lock
logs/
*.log

# Trained models. Build artifacts: regenerable by refitting, and large.
models/
*.pkl

# Cached market data and backtest output.
#
# data/cache/bars/ is deliberately NOT ignored. The scheduled GitHub Actions
# run commits it back, so the runner starts from a warm cache instead of
# refetching four years of daily bars for fourteen symbols on every run.
data/cache/*
!data/cache/bars/
backtest/results/*
!backtest/results/.gitkeep

# state.db is committed by the scheduled run: it is the system's memory, and
# a job that starts with an empty one has no history to reason about. The WAL
# and shared-memory sidecars are not, since they are transient and would
# conflict on every push.
data/state.db-wal
data/state.db-shm

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# macOS / editors
.DS_Store
.vscode/
.idea/

# Next.js dashboard
dashboard/node_modules/
dashboard/.next/
dashboard/out/
dashboard/.vercel
dashboard/next-env.d.ts
.vercel
.ruff_cache/

# Sentinel dropped by --refresh when a fill settled or a position changed.
# Consumed by .github/workflows/refresh.yml; never committed.
data/.material-change

# Trial registry. Append-only record of every backtest configuration tested.
# Committed on purpose: the trial count is what the deflated Sharpe corrects
# for, and a count that resets is a count that understates the search.
!data/trials.db
