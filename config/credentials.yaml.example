# Copy to credentials.yaml and fill in. credentials.yaml is gitignored.
#
# Preferred path is .env, not this file. The system reads keys from the
# environment first and only falls back to credentials.yaml. Both are
# gitignored. Never paste real keys into a chat window.

alpaca:
  api_key: your_key_here
  secret_key: your_secret_here
  paper: true
  base_url: https://paper-api.alpaca.markets

alerts:
  # Optional. Phase 8, monitoring and alerts.
  email_to:
  smtp_host:
  smtp_port: 587
  smtp_user:
  smtp_password:
  webhook_url:
